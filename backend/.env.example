NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/physics_ai_tutor

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins.
FRONTEND_URL=http://localhost:3000
COOKIE_NAME=physics_token
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Comma-separated emails promoted to admin on registration.
ADMIN_EMAILS=admin@example.com

# AI provider: "gemini" (free tier) or "openai".
AI_PROVIDER=gemini

# Gemini stays on the server only. Get a free key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-gemini-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_MAX_OUTPUT_TOKENS=2048

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_TEMPERATURE=0.2

RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_MAX_CHUNKS=50000
MAX_CONTEXT_CHARS=14000
ANSWER_CACHE_TTL_DAYS=7

CHAT_INPUT_COST_PER_MILLION=0.4
CHAT_OUTPUT_COST_PER_MILLION=1.6
EMBEDDING_COST_PER_MILLION=0.02

DAILY_MESSAGE_LIMIT=100
MAX_PDF_MB=30

ENABLE_ATLAS_VECTOR_SEARCH=false
ATLAS_VECTOR_INDEX=vector_index
