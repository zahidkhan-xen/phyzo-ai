# ---------------------------------------------------------------------------
# Physics AI Tutor — environment reference
#
# Backend: copy this file to `backend/.env`
# Frontend: create `frontend/.env.local` with:
#   NEXT_PUBLIC_API_URL=http://localhost:5000/api
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/physics_ai_tutor

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API with credentials.
FRONTEND_URL=http://localhost:3000
COOKIE_NAME=physics_token
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Private addresses promoted to admin on registration (no email verification).
ADMIN_EMAILS=admin@example.com

# Server-only OpenAI configuration. Never expose this to the frontend.
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_TEMPERATURE=0.2

# Strict retrieval and context budgets.
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_MAX_CHUNKS=50000
MAX_CONTEXT_CHARS=14000
ANSWER_CACHE_TTL_DAYS=7

# Estimated USD pricing per 1M tokens (adjust to current OpenAI pricing).
CHAT_INPUT_COST_PER_MILLION=0.4
CHAT_OUTPUT_COST_PER_MILLION=1.6
EMBEDDING_COST_PER_MILLION=0.02

# Limits
DAILY_MESSAGE_LIMIT=100
MAX_PDF_MB=30
UPLOAD_DIR=uploads

# Optional MongoDB Atlas Vector Search
ENABLE_ATLAS_VECTOR_SEARCH=false
ATLAS_VECTOR_INDEX=vector_index

# Frontend (put in frontend/.env.local, not backend/.env)
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
